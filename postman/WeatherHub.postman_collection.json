{
  "info": {
    "_postman_id": "9f20d340-d1f8-4c10-927e-b557acbc8f92",
    "name": "WeatherHub API",
    "description": "WeatherHub REST API smoke and CRUD checks. Set favoriteId after creating a favourite. Requires the Flask server, MySQL, and OpenWeather configuration for the respective requests.",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
  },
  "variable": [
    { "key": "baseUrl", "value": "http://localhost:5000" },
    { "key": "favoriteId", "value": "1" },
    { "key": "city", "value": "Vijayawada" },
    { "key": "country", "value": "IN" }
  ],
  "item": [
    { "name": "Health check", "request": { "method": "GET", "url": "{{baseUrl}}/api/health" }, "event": [{ "listen": "test", "script": { "type": "text/javascript", "exec": ["pm.test('Health check returns 200', () => pm.response.to.have.status(200));", "pm.test('Health response is JSON success', () => pm.expect(pm.response.json().success).to.eql(true));"] } }] },
    { "name": "Current weather — valid city", "request": { "method": "GET", "url": "{{baseUrl}}/api/weather/current?city={{city}}&country={{country}}" }, "event": [{ "listen": "test", "script": { "type": "text/javascript", "exec": ["pm.test('Valid city returns weather', () => pm.response.to.have.status(200));", "pm.test('Weather payload contains city and temperature', () => { const d = pm.response.json().data; pm.expect(d.city).to.be.a('string'); pm.expect(d.temperature).to.be.a('number'); });"] } }] },
    { "name": "Current weather — missing city", "request": { "method": "GET", "url": "{{baseUrl}}/api/weather/current" }, "event": [{ "listen": "test", "script": { "type": "text/javascript", "exec": ["pm.test('Missing city is rejected', () => pm.response.to.have.status(400));"] } }] },
    { "name": "Current weather — invalid city", "request": { "method": "GET", "url": "{{baseUrl}}/api/weather/current?city=not-a-real-city-88271&country=ZZ" }, "event": [{ "listen": "test", "script": { "type": "text/javascript", "exec": ["pm.test('Invalid city returns not found', () => pm.response.to.have.status(404));"] } }] },
    { "name": "Five-day forecast — valid city", "request": { "method": "GET", "url": "{{baseUrl}}/api/weather/forecast?city={{city}}&country={{country}}" }, "event": [{ "listen": "test", "script": { "type": "text/javascript", "exec": ["pm.test('Forecast returns 200', () => pm.response.to.have.status(200));", "pm.test('Forecast entries are returned', () => pm.expect(pm.response.json().data).to.be.an('array').that.is.not.empty);"] } }] },
    { "name": "Five-day forecast — invalid city", "request": { "method": "GET", "url": "{{baseUrl}}/api/weather/forecast?city=not-a-real-city-88271&country=ZZ" }, "event": [{ "listen": "test", "script": { "type": "text/javascript", "exec": ["pm.test('Invalid forecast city returns not found', () => pm.response.to.have.status(404));"] } }] },
    { "name": "Create favourite — valid", "request": { "method": "POST", "header": [{ "key": "Content-Type", "value": "application/json" }], "body": { "mode": "raw", "raw": "{\n  \"city\": \"Vijayawada\",\n  \"country\": \"IN\",\n  \"nickname\": \"Home\"\n}", "options": { "raw": { "language": "json" } } }, "url": "{{baseUrl}}/api/favorites" }, "event": [{ "listen": "test", "script": { "type": "text/javascript", "exec": ["pm.test('Favourite created (201) or duplicate rejected (409)', () => pm.expect([201,409]).to.include(pm.response.code));", "if (pm.response.code === 201) { pm.collectionVariables.set('favoriteId', pm.response.json().data.id); }"] } }] },
    { "name": "Create favourite — missing required fields", "request": { "method": "POST", "header": [{ "key": "Content-Type", "value": "application/json" }], "body": { "mode": "raw", "raw": "{\n  \"nickname\": \"No city provided\"\n}", "options": { "raw": { "language": "json" } } }, "url": "{{baseUrl}}/api/favorites" }, "event": [{ "listen": "test", "script": { "type": "text/javascript", "exec": ["pm.test('Invalid favourite is rejected', () => pm.response.to.have.status(400));"] } }] },
    { "name": "Create favourite — duplicate city/country", "request": { "method": "POST", "header": [{ "key": "Content-Type", "value": "application/json" }], "body": { "mode": "raw", "raw": "{\n  \"city\": \"Vijayawada\",\n  \"country\": \"IN\"\n}", "options": { "raw": { "language": "json" } } }, "url": "{{baseUrl}}/api/favorites" }, "event": [{ "listen": "test", "script": { "type": "text/javascript", "exec": ["pm.test('Duplicate returns conflict', () => pm.response.to.have.status(409));"] } }] },
    { "name": "Read favourites — all", "request": { "method": "GET", "url": "{{baseUrl}}/api/favorites" }, "event": [{ "listen": "test", "script": { "type": "text/javascript", "exec": ["pm.test('List favourites returns 200', () => pm.response.to.have.status(200));", "pm.test('List payload is an array', () => pm.expect(pm.response.json().data).to.be.an('array'));"] } }] },
    { "name": "Read favourite — existing ID", "request": { "method": "GET", "url": "{{baseUrl}}/api/favorites/{{favoriteId}}" }, "event": [{ "listen": "test", "script": { "type": "text/javascript", "exec": ["pm.test('Read favourite returns 200', () => pm.response.to.have.status(200));"] } }] },
    { "name": "Read favourite — nonexistent ID", "request": { "method": "GET", "url": "{{baseUrl}}/api/favorites/99999999" }, "event": [{ "listen": "test", "script": { "type": "text/javascript", "exec": ["pm.test('Missing favourite returns 404', () => pm.response.to.have.status(404));"] } }] },
    { "name": "Update favourite — valid", "request": { "method": "PUT", "header": [{ "key": "Content-Type", "value": "application/json" }], "body": { "mode": "raw", "raw": "{\n  \"city\": \"Vijayawada\",\n  \"country\": \"IN\",\n  \"nickname\": \"Updated nickname\"\n}", "options": { "raw": { "language": "json" } } }, "url": "{{baseUrl}}/api/favorites/{{favoriteId}}" }, "event": [{ "listen": "test", "script": { "type": "text/javascript", "exec": ["pm.test('Update returns success (or duplicate conflict)', () => pm.expect([200,409]).to.include(pm.response.code));"] } }] },
    { "name": "Update favourite — invalid data", "request": { "method": "PUT", "header": [{ "key": "Content-Type", "value": "application/json" }], "body": { "mode": "raw", "raw": "{\n  \"city\": \"\",\n  \"country\": \"\"\n}", "options": { "raw": { "language": "json" } } }, "url": "{{baseUrl}}/api/favorites/{{favoriteId}}" }, "event": [{ "listen": "test", "script": { "type": "text/javascript", "exec": ["pm.test('Invalid update returns 400', () => pm.response.to.have.status(400));"] } }] },
    { "name": "Update favourite — nonexistent ID", "request": { "method": "PUT", "header": [{ "key": "Content-Type", "value": "application/json" }], "body": { "mode": "raw", "raw": "{\n  \"city\": \"Vijayawada\",\n  \"country\": \"IN\"\n}", "options": { "raw": { "language": "json" } } }, "url": "{{baseUrl}}/api/favorites/99999999" }, "event": [{ "listen": "test", "script": { "type": "text/javascript", "exec": ["pm.test('Missing update target returns 404', () => pm.response.to.have.status(404));"] } }] },
    { "name": "Delete favourite — nonexistent ID", "request": { "method": "DELETE", "url": "{{baseUrl}}/api/favorites/99999999" }, "event": [{ "listen": "test", "script": { "type": "text/javascript", "exec": ["pm.test('Missing delete target returns 404', () => pm.response.to.have.status(404));"] } }] },
    { "name": "Delete favourite — selected ID", "request": { "method": "DELETE", "url": "{{baseUrl}}/api/favorites/{{favoriteId}}" }, "event": [{ "listen": "test", "script": { "type": "text/javascript", "exec": ["pm.test('Delete returns success or already missing', () => pm.expect([200,404]).to.include(pm.response.code));"] } }] }
  ]
}
